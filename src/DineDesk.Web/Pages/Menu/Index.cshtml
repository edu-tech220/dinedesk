@page
@model DineDesk.Web.Pages.Menu.IndexModel
@{
    ViewData["Title"] = "Menu";
}

<h1 class="mb-4">Menu</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Happy hour</th>
            <th>Availability</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.MenuItems)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Category</td>
                <td>@item.Price.ToString("C")</td>
                <td>@(item.IsHappyHourEligible ? "Yes" : "No")</td>
                <td>
                    <span class="badge @(item.IsAvailable ? "bg-success" : "bg-danger")">
                        @(item.IsAvailable ? "Available" : "86'd")
                    </span>
                </td>
                <td>
                    <form method="post" asp-page-handler="ToggleAvailability">
                        <input type="hidden" name="MenuItemId" value="@item.Id" />
                        <input type="hidden" name="ETag" value="@item.ETag" />
                        <input type="hidden" name="IsAvailable" value="@(!item.IsAvailable)" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            @(item.IsAvailable ? "Mark 86'd" : "Re-enable")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<h3 class="mt-5">Add a menu item</h3>
<form method="post" asp-page-handler="Create">
    <div class="row g-2">
        <div class="col-md-3">
            <label class="form-label">Name</label>
            <input type="text" name="Name" class="form-control" required />
        </div>
        <div class="col-md-3">
            <label class="form-label">Category</label>
            <input type="text" name="Category" class="form-control" required />
        </div>
        <div class="col-md-2">
            <label class="form-label">Price</label>
            <input type="number" step="0.01" min="0.01" name="Price" class="form-control" required />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check">
                <input type="checkbox" name="IsHappyHourEligible" value="true" class="form-check-input" id="hh" />
                <label class="form-check-label" for="hh">Happy-hour eligible</label>
            </div>
        </div>
    </div>

    <h5 class="mt-3">Recipe (quantity per serving; leave 0 to skip)</h5>
    <div class="row row-cols-2 row-cols-md-4 g-2">
        @foreach (var ingredient in Model.Ingredients)
        {
            <div class="col">
                <label class="form-label">@ingredient.Name (@ingredient.UnitOfMeasure)</label>
                <input type="number" step="0.01" min="0" name="RecipeQuantity_@ingredient.Id" class="form-control" value="0" />
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary mt-3">Create menu item</button>
</form>
